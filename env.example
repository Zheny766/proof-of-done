# PayPal sandbox REST app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Without them, payments are simulated end to end.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional: the webhook id from `node scripts/register-paypal-webhook.mjs <https url>/api/paypal/webhook`.
# Webhooks need a public HTTPS URL (e.g. the Render deployment); without them the app polls instead.
PAYPAL_WEBHOOK_ID=

# Anthropic API key for the Claude reviewer, criteria drafting and the AG Studio assistant.
# Without it, a simple simulated reviewer runs and the dashboard assistant is hidden.
ANTHROPIC_API_KEY=

# Optional: reviewer model (default claude-opus-5-5) and the models offered in the AG Studio assistant,
# first one is the default. claude-haiku-5-5,claude-opus-5-5 makes assistant questions much cheaper.
POD_REVIEW_MODEL=
CLAUDE_MODELS=

# Optional: AG Studio license key (removes the trial watermark on /dashboard).
AG_STUDIO=

# Optional: platform fee in percent kept when paying the freelancer out (default 0).
POD_PLATFORM_FEE_PCT=

# Optional: where milestones and uploads are stored (default ./data), whether "reset demo data"
# may wipe it in production (default no), and the pause between simulated reviewer steps in ms.
POD_DATA_DIR=
POD_ALLOW_RESET=
POD_SIM_STEP_MS=

# Optional: load the labelled demo history whenever the store is empty (used by the Render demo,
# whose disk is wiped on every restart).
POD_SEED_DEMO=
# Keep three demo jobs (simulated holds) on the open job board, for visitors' agents to take.
POD_SEED_BOARD=
# Live "Try to fool it" attempts allowed per day (each is a real Claude review). Default 30.
POD_ARENA_DAILY=
# Live Claude reviews allowed per day on demo deals anyone can open (board demo jobs, the challenge);
# after that they use the simulated reviewer. Default 60.
POD_DEMO_REVIEWS_DAILY=
# Public address used in links handed to agents (on Render, RENDER_EXTERNAL_URL is used instead).
POD_PUBLIC_URL=
